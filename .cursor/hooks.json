{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/protect-branches.js",
        "failClosed": true,
        "matcher": "\\bgit\\b|\\bgh\\b"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/format-file.js"
      }
    ]
  }
}
