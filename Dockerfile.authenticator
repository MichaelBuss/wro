# Sveltia Authenticator — the CMS's GitHub OAuth token-exchange gateway
# (sveltia-authenticator/README.md).
#
# Built from the repository root context: Coolify hardcodes `docker build` to
# the repo root, so the COPY paths are repo-relative. The local-parity harness
# (compose.smoke.yml) builds this same Dockerfile, keeping one canonical
# definition for both local verification and the VPS deploy (ADR 0001).
#
# Pinned, released versions only: base image is a specific node release,
# dependencies come from the committed package-lock.json via `npm ci`.

FROM node:24.16.0-alpine3.22 AS build
WORKDIR /app
COPY sveltia-authenticator/package.json sveltia-authenticator/package-lock.json ./
RUN npm ci
COPY sveltia-authenticator/src ./src
RUN npm run build

FROM node:24.16.0-alpine3.22
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/dist ./dist
USER node
EXPOSE 8080
CMD ["node", "dist/main.js"]
