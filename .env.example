# Copy to .env for local development (matches docker-compose.yml).
# The .env file is gitignored — never commit real secrets.

# Postgres connection string for registration + auth data.
DATABASE_URL=postgres://wro:wro@localhost:5432/wro

# Secret used by Better Auth to sign sessions. Generate one for real use, e.g.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me

# Public origin the app runs on (used as the WebAuthn origin).
BETTER_AUTH_URL=http://localhost:3000

# WebAuthn relying-party id (host only, no protocol or port).
PASSKEY_RP_ID=localhost

# Comma-separated emails auto-granted the organizer role on first signup.
# Add your email here before signing up to become the first organizer.
# See docs/architecture/authentication.md (Organizer Role & Bootstrapping).
ORGANIZER_EMAIL_ALLOWLIST=you@example.com
